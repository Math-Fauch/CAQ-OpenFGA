model
  schema 1.1

type user

type team
  relations
    define member: [user]

type folder
  relations
    define parent: [folder]
    define viewer: [user, team#member] or parent
    define editor: [user, team#member] or parent

type document
  relations
    define owner: [user]
    define folder: [folder]
    define editor: [user, team#member] or owner
    define viewer: [user, team#member] or editor
